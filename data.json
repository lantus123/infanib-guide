    {
      "id": "4",
      "number": 4,
      "title": "膕窩角 Popliteal Angle",
      "domain": "仰臥",
      "ageLabel": "出生起；本版僅 6／12 月開放計分",
      "minAge": 0,
      "maxAge": 18,
      "procedure": [
        "握膝附近，屈髖，雙腿稍向身體兩側外展，臀部維持近台面。",
        "逐步伸膝直到遇到阻力，以膝後方為頂點，量大腿與小腿間角度；兩側比較。"
      ],
      "observe": [
        "明顯左右不對稱依原表優先給 1 分。"
      ],
      "figures": [
