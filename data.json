    {
      "id": "5",
      "number": 5,
      "title": "髖外展角 Leg Abduction",
      "domain": "仰臥",
      "ageLabel": "出生起；本版僅 6／12 月開放計分",
      "minAge": 0,
      "maxAge": 18,
      "procedure": [
        "握住雙膝附近，使兩腿保持伸直，緩慢向外分開，遇阻力即停。",
        "以會陰處為頂點，量兩腿之間的夾角。"
      ],
      "observe": [
        "注意膝部是否仍伸直及骨盆是否代償。"
