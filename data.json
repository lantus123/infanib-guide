    {
      "id": "2",
      "number": 2,
      "title": "圍巾徵象 Scarf Sign",
      "domain": "仰臥",
      "ageLabel": "出生起；本版僅 6／12 月開放計分",
      "minAge": 0,
      "maxAge": 18,
      "procedure": [
        "握住肘部附近，將上臂輕柔移過胸前，至容易活動的終點，不用力硬拉。",
        "以腋下為頂點，量上臂與腋下向下假想垂線的夾角。"
      ],
      "observe": [
        "角度須與來源圖採相同定義；遇阻力即停。"
      ],
      "figures": [
