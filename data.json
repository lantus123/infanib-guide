    {
      "id": "3",
      "number": 3,
      "title": "足跟靠耳 Heel to Ear",
      "domain": "仰臥",
      "ageLabel": "出生起；本版僅 6／12 月開放計分",
      "minAge": 0,
      "maxAge": 18,
      "procedure": [
        "握住膝部附近，使腿伸直；臀部盡量留在檢查台上或貼近台面。",
        "將腿往頭部方向移，量軀幹與腿的夾角，以髖為頂點；測髖部柔軟度，不是彎曲下背。"
      ],
      "observe": [
        "角度愈小代表腿更靠近軀幹，不可套用膕窩角的年齡數值。"
      ],
      "figures": [
        {
          "src": "assets/item-03-2-6b.png",
